
logger:
  file:
    path: ./var/log/open5gs/lmf.log
    level: debug   # fatal|error|warn|info(default)|debug|tracelogger:
#  level: info   # fatal|error|warn|info(default)|debug|tracelogger:

global:
  max:
    ue: 1024  # The number of UE can be increased depending on memory size.
#    peer: 64

lmf:
  sbi:
    server:
      - address: 139.30.202.193
        port: 7777
    client:
#      nrf:
#        - uri: http://127.0.0.10:7777
      amf:
        - uri: http://139.30.202.191:7777
      scp:
        - uri: http://139.30.202.191:7778

  lcs-up:
    server:
      interface: eth0
      family: 0 # 0 = IPv4, 1 = IPv6, 2 = FQDN (currently not handled via config file)
      tls:
        base: 0 # 0 = TCP, 1 = QUIC via UDP
        private_key: /etc/open5gs/tls/lmf.key
        cert: /etc/open5gs/tls/lmf.crt
      timeout: 3  # timeout for LCS-UP Binding procedure (TLS handshake, LCS-UP Binding Request reception) [s]

    timer:
      t5012: 10 # T5012: (Re-)Transmission of USER PLANE CONNECTION ESTABLISHMENT COMMAND message [s]
      inactivity: 2 # TS 24.572, 4.2: Implementation-specific expiry timer for LCS-UP connections in idle state [s]

################################################################################
# SBI Server
################################################################################
#  o Bind to the address on the eth0 and advertise as open5gs-lmf.svc.local
#  sbi:
#    server:
#      - dev:eth0
#        advertise: open5gs-lmf.svc.local
#
#  o Specify a custom port number 7777 while binding to the given address
#  sbi:
#    server:
#      - address: lmf.localdomain
#        port: 7777
#
#  o Bind to 127.0.0.16 and advertise as open5gs-lmf.svc.local
#  sbi:
#    server:
#      - address: 127.0.0.16
#        port: 7777
#        advertise: open5gs-lmf.svc.local
#
#  o Bind to port 7777 but advertise with a different port number 8888
#  sbi:
#    server:
#      - address: 127.0.0.16
#        port: 7777
#        advertise: open5gs-lmf.svc.local:8888
#
################################################################################
# SBI Client
################################################################################
#  o Direct Communication with NRF
#  sbi:
#    client:
#      nrf:
#        - uri: http://127.0.0.10:7777
#
#  o Indirect Communication by Delegating to SCP
#  sbi:
#    client:
#      scp:
#        - uri: http://127.0.0.200:7777
#
#  o Indirect Communication without Delegation
#  sbi:
#    client:
#      nrf:
#        - uri: http://127.0.0.10:7777
#      scp:
#        - uri: http://127.0.0.200:7777
#      delegated:
#        nrf:
#          nfm: no    # Directly communicate NRF management functions
#          disc: no   # Directly communicate NRF discovery
#        scp:
#          next: no   # Do not delegate to SCP for next-hop
#
#  o Indirect Communication with Delegated Discovery
#  sbi:
#    client:
#      nrf:
#        - uri: http://127.0.0.10:7777
#      scp:
#        - uri: http://127.0.0.200:7777
#      delegated:
#        nrf:
#          nfm: no    # Directly communicate NRF management functions
#          disc: yes  # Delegate discovery to SCP
#        scp:
#          next: yes  # Delegate to SCP for next-hop communications
#
#  o Default delegation: all communications are delegated to the SCP
#  sbi:
#    client:
#      nrf:
#        - uri: http://127.0.0.10:7777
#      scp:
#        - uri: http://127.0.0.200:7777
#      # No 'delegated' section; defaults to AUTO delegation
#
